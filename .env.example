# Configurações do WhatsApp Daily Bot

# Número de destino com código do país (DDI) e DDD, apenas números. Exemplo para Brasil (SP): 5511999999999
PHONE_NUMBER=5511999999999

# Mensagem a ser enviada diariamente
MESSAGE=Olá! Esta é uma mensagem diária enviada automaticamente. Tenha um ótimo dia!

# Horário de disparo diário no formato 24 horas (HH:MM)
SCHEDULE_TIME=09:00

# Executar navegador em modo oculto (headless) após login realizado: True ou False
HEADLESS=False
